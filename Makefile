BOOK_LANG ?= en
BUILD_ROOT := .build/$(BOOK_LANG)
PREVIEW_PORT ?= 3002

.PHONY: e2e serve serve-i18n build check summary clean js test deploy i18n i18n-status i18n-stamp i18n-new

js:
	node tools/build/bundle.mjs

test:
	npx vitest run

# English is the hand-edited source. A translated book gets its generated pages from
# assemble_lang.mjs after the overlay has been copied.
summary:
ifeq ($(BOOK_LANG),en)
	python3 tools/build/gen_summary.py --lang en --src mdbook/src
else
	@echo "SUMMARY.md for $(BOOK_LANG) is generated by assemble_lang.mjs"
endif

i18n:
ifeq ($(BOOK_LANG),en)
	node tools/build/gen_i18n_js.mjs --lang en --out mdbook/theme/i18n.js --site single
else
	@echo "i18n.js for $(BOOK_LANG) is generated by assemble_lang.mjs"
endif

check:
ifeq ($(BOOK_LANG),en)
	python3 tools/check/check_chapters.py --lang en --root mdbook/src
else
	node tools/build/assemble_lang.mjs --lang $(BOOK_LANG) --out $(BUILD_ROOT) --site single
	python3 tools/check/check_chapters.py --lang $(BOOK_LANG) --root $(BUILD_ROOT)/src
endif

ifeq ($(BOOK_LANG),en)
build: summary js i18n
	cd mdbook && mdbook build
	node tools/build/postprocess_lang.mjs --root mdbook/book --lang en --site single \
		--strings mdbook/i18n/strings.en.json
	node tools/build/gen_sw.mjs --root mdbook/book --lang en --exclude mr
else
build: js
	node tools/build/assemble_lang.mjs --lang $(BOOK_LANG) --out $(BUILD_ROOT) --site single
	cd $(BUILD_ROOT) && mdbook build
	node tools/build/postprocess_lang.mjs --root $(BUILD_ROOT)/book --lang $(BOOK_LANG) --site single \
		--status $(BUILD_ROOT)/i18n-status.json \
		--strings mdbook/i18n/$(BOOK_LANG)/strings.json
	node tools/build/gen_sw.mjs --root $(BUILD_ROOT)/book --lang $(BOOK_LANG)
endif

# Browser tests run on their own copy of the book, so a running `make serve` cannot disturb them.
ifeq ($(BOOK_LANG),en)
e2e: summary js i18n
	rm -rf .e2e-book
	cd mdbook && mdbook build -d $(CURDIR)/.e2e-book
	node tools/build/postprocess_lang.mjs --root .e2e-book --lang en --site single \
		--strings mdbook/i18n/strings.en.json
	node tools/build/gen_sw.mjs --root .e2e-book --lang en --exclude mr
	npx playwright test
else
# Deploy-shape tests always use the combined site: English at /, Marathi at /mr/.
e2e: js
	node tools/build/build_combined.mjs --out $(CURDIR)/.e2e-combined
	npx playwright test -c playwright.i18n.config.ts
endif

# Live-reloading local server at http://localhost:3000 (English) or 3001 (Marathi).
# Marathi overlay changes need a restart; the assembled copy is not watched.
ifeq ($(BOOK_LANG),en)
serve: summary js i18n
	cd mdbook && mdbook serve --open
else
serve: js
	node tools/build/assemble_lang.mjs --lang $(BOOK_LANG) --out $(BUILD_ROOT) --site single
	cd $(BUILD_ROOT) && mdbook serve --open -p 3001
endif

# Combined preview: English at /, Marathi at /mr/, with the language dropdown.
# Rebuilds and reloads when source, theme or overlay files change.
serve-i18n:
	node tools/build/serve_combined.mjs --port $(PREVIEW_PORT)

# Publish the combined site to GitHub Pages (gh-pages branch). No CI: run this by hand.
deploy:
	./tools/build/deploy.sh

i18n-status:
	python3 tools/check/i18n_status.py --lang mr

i18n-stamp:
	@test -n "$(ID)" || (echo "ID=... is required (for example ID=T0.1)" >&2; exit 1)
	@test -n "$(REVIEWER)" || (echo "REVIEWER=... is required" >&2; exit 1)
	python3 tools/i18n/stamp.py --lang mr --id "$(ID)" --reviewer "$(REVIEWER)" $(if $(DATE),--date "$(DATE)",)

i18n-new:
	@test "$(BOOK_LANG)" != "en" || (echo "BOOK_LANG=... is required (for example BOOK_LANG=hi)" >&2; exit 1)
	python3 tools/i18n/new_language.py --lang "$(BOOK_LANG)"

clean:
	rm -rf mdbook/book .build .e2e-book .e2e-book-mr .e2e-combined .pages-build
