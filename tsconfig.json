{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "noEmit": true, "resolveJsonModule": true,
    "allowJs": true
  },
  "include": ["tools/forward-test/cli.ts", "tools/build/*.mjs", "packages/*/src", "packages/*/test", "tests/i18n", "data"]
}
